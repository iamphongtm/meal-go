{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "catalog_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "restaurantId": { "type": "keyword" },
      "name": { "type": "text", "analyzer": "catalog_text" },
      "status": { "type": "keyword" },
      "addressLine": { "type": "text" },
      "location": { "type": "geo_point" },
      "restaurantUpdatedAt": { "type": "date" },
      "updatedAt": { "type": "date" },
      "menuItems": {
        "type": "nested",
        "properties": {
          "menuItemId": { "type": "keyword" },
          "name": { "type": "text", "analyzer": "catalog_text" },
          "status": { "type": "keyword" },
          "basePrice": { "type": "scaled_float", "scaling_factor": 100 },
          "imageUrl": { "type": "keyword", "index": false },
          "updatedAt": { "type": "date" }
        }
      }
    }
  },
  "aliases": { "restaurants": { "is_write_index": true } }
}
