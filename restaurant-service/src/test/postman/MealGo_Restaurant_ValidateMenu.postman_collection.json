  "item": [
    {
      "name": "A - Happy path",
      "item": [
        {
          "name": "A1 - Validate active item and option",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Menu is valid', () => pm.expect(body.valid).to.eql(true));",
                  "pm.test('Currency is VND', () => pm.expect(body.currency).to.eql('VND'));",
                  "pm.test('Unit price is authoritative', () => pm.expect(Number(body.items[0].unitPrice)).to.eql(80000));",
                  "pm.test('No validation issue', () => pm.expect(body.issues).to.be.an('array').that.is.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Account-Id",
                "value": "{{accountId}}",
                "type": "text"
              },
              {
                "key": "X-User-Roles",
                "value": "SERVICE",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"lineId\": \"aaaaaaaa-0000-0000-0000-000000000001\",\n      \"menuItemId\": \"{{activeItemId}}\",\n      \"quantity\": 2,\n      \"selectedOptionIds\": [\"{{activeOptionId}}\"]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{restaurantBaseUrl}}/internal/restaurants/{{restaurantId}}/menu/validate",
              "host": [
                "{{restaurantBaseUrl}}"
              ],
              "path": [
                "internal",
                "restaurants",
                "{{restaurantId}}",
                "menu",
                "validate"
              ]
            },
            "description": "Expected: valid=true, basePrice=65000, additionalPrice=15000, unitPrice=80000."
          },
          "response": []
        }
      ]
    },
    {
