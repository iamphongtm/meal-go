              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Menu is invalid', () => pm.expect(body.valid).to.eql(false));",
                  "pm.test('Returns MENU_ITEM_UNAVAILABLE', () => pm.expect(body.issues.map(i => i.code)).to.include('MENU_ITEM_UNAVAILABLE'));",
                  "pm.test('Does not return partial prices', () => pm.expect(body.items).to.be.an('array').that.is.empty);"
                ]
