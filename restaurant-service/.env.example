# Local development placeholders only. Copy to .env and supply your own values.
# Compose overrides database addresses to use restaurant-db internally.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mealgo_restaurant
SPRING_DATASOURCE_USERNAME=restaurant
SPRING_DATASOURCE_PASSWORD=restaurant
AWS_ACCESS_KEY=replace-with-your-access-key
AWS_SECRET_KEY=replace-with-your-secret-key
AWS_S3_BUCKET=replace-with-your-bucket
AWS_REGION=ap-southeast-1
AWS_CDN_BASE_URL=https://cdn.example.com
